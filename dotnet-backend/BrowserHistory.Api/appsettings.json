{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/browser-history-api-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../data/browser-history.db"
  },
  "Jwt": {
    "Secret": "your-super-secret-jwt-key-that-is-at-least-32-characters-long",
    "Issuer": "BrowserHistory.Api",
    "Audience": "BrowserHistory.Client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Auth": {
    "SharedSecret": "your-shared-secret-for-device-registration"
  },
  "Caching": {
    "DeviceCacheDuration": "00:30:00",
    "SyncEventsCacheDuration": "00:05:00",
    "HistoryCacheDuration": "00:10:00",
    "MaxItemsPerCategory": 1000
  },
  "AllowedHosts": "*"
}
