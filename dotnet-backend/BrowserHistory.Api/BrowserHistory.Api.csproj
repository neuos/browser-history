<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\BrowserHistory.Application\BrowserHistory.Application.csproj" />
    <ProjectReference Include="..\BrowserHistory.Infrastructure\BrowserHistory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Native AOT Configuration - disabled temporarily for testing -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    
    <!--
      Reflection-based JSON stays on: PublishAot is false above, and ApiJsonContext (the source-gen
      resolver meant to replace reflection for AOT) is never registered in Program.cs, is missing
      several DTOs used by real endpoints, and references at least one DTO from the wrong
      namespace. Setting this to false without a working resolver wired in makes every JSON
      endpoint fail at startup (System.Text.Json.ThrowHelper.ThrowNotSupportedException_NoMetadataForType).
      Revisit together when AOT publishing is actually turned back on.
    -->
  </PropertyGroup>

  <!-- Native AOT warnings suppression for external dependencies -->
  <ItemGroup>
    <SuppressNativeAotTrimming Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <SuppressNativeAotTrimming Include="Serilog.AspNetCore" />
    <SuppressNativeAotTrimming Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <!-- Preserve assemblies for reflection -->
  <ItemGroup>
    <TrimmerRootAssembly Include="BrowserHistory.Application" />
    <TrimmerRootAssembly Include="BrowserHistory.Infrastructure" />
    <TrimmerRootAssembly Include="BrowserHistory.Domain" />
  </ItemGroup>

</Project>
