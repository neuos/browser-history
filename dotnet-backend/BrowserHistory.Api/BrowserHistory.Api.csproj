<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\BrowserHistory.Application\BrowserHistory.Application.csproj" />
    <ProjectReference Include="..\BrowserHistory.Infrastructure\BrowserHistory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Native AOT Configuration - disabled temporarily for testing -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    
    <!--
      Reflection-based JSON stays on: PublishAot is false above. A prior source-gen
      JsonSerializerContext (meant to replace reflection for AOT) was removed as dead code - it
      was never registered in Program.cs, was missing several DTOs used by real endpoints, and
      referenced at least one DTO from a namespace that no longer exists. Setting PublishAot to
      true without a working resolver wired in makes every JSON endpoint fail at startup
      (System.Text.Json.ThrowHelper.ThrowNotSupportedException_NoMetadataForType). A fresh
      JsonSerializerContext would need to be written from scratch, matching the DTOs as they
      actually are, before AOT publishing could be turned back on.
    -->
  </PropertyGroup>

  <!-- Native AOT warnings suppression for external dependencies -->
  <ItemGroup>
    <SuppressNativeAotTrimming Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <SuppressNativeAotTrimming Include="Serilog.AspNetCore" />
    <SuppressNativeAotTrimming Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <!-- Preserve assemblies for reflection -->
  <ItemGroup>
    <TrimmerRootAssembly Include="BrowserHistory.Application" />
    <TrimmerRootAssembly Include="BrowserHistory.Infrastructure" />
    <TrimmerRootAssembly Include="BrowserHistory.Domain" />
  </ItemGroup>

</Project>
