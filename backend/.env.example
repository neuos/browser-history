# Environment variables for development
# Copy this to .env.local and modify for your setup

# Shared secret for device registration (change this!)
SHARED_SECRET=your-super-secret-key-for-device-registration-change-this

# JWT signing secret (change this!)
JWT_SECRET=your-jwt-signing-secret-change-this

# Database path
DATABASE_PATH=./data/history.db

# CORS settings
CORS_ORIGIN=*

# Server settings
PORT=8000
HOST=0.0.0.0

# Log level
LOG_LEVEL=info
