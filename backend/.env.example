# Environment Configuration
# Copy this to .env and modify the values as needed

# Security
SHARED_SECRET=your-super-secret-key-for-device-registration # Required - Keep this secret!
JWT_SECRET=your-jwt-signing-secret-key # Required - Keep this secret!

# Server
# HOST=0.0.0.0 # Optional (default: 0.0.0.0)
# PORT=8000 # Optional (default: 8000)
# CORS_ORIGIN=https://yourdomain.com # Optional (default: *)

# Database
# DATABASE_PATH=./data/history.db # Optional (default: ./data/history.db)

