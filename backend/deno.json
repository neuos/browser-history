{
  "name": "history-sync-backend",
  "version": "1.0.0",
  "description": "Backend server for cross-device browser history synchronization",
  "type": "module",
  "exports": "./src/main.ts",
  "imports": {
    "hono": "jsr:@hono/hono@^4.8.2",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0"
  },
  "tasks": {
    "dev": "deno run --allow-all --watch src/main.ts",
    "start": "deno run --allow-all src/main.ts",
    "db:migrate": "deno run --allow-all src/scripts/migrate.ts",
    "test": "deno test --allow-all src/tests/",
    "test:integration": "./test.sh"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}